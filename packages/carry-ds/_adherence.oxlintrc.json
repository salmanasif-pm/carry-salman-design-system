{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/diagram/**",
              "components/signature/**",
              "scripts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoundaryFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|children|outside|outsideLabel|ports|style|key|ref|className|style|children)$/]",
        "message": "<BoundaryFrame> doesn't accept that prop. Declared props: label, meta, children, outside, outsideLabel, ports, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|signal)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'signal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composition'] > JSXAttribute > JSXIdentifier[name!=/^(?:form|above|below|lead|leadLabel|aboveLabel|belowLabel|showLabels|orientation|aboveSize|style|key|ref|className|style|children)$/]",
        "message": "<Composition> doesn't accept that prop. Declared props: form, above, below, lead, leadLabel, aboveLabel, belowLabel, showLabels, orientation, aboveSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composition'] > JSXAttribute[name.name='form'] > Literal[value!=/^(?:handle-truth|claim-support|outcome-enabled|question-conditions|direction-consequence|intention-reflection|observation-development)$/]",
        "message": "<Composition> form must be one of 'handle-truth' | 'claim-support' | 'outcome-enabled' | 'question-conditions' | 'direction-consequence' | 'intention-reflection' | 'observation-development'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composition'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Composition> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composition'] > JSXAttribute[name.name='aboveSize'] > Literal[value!=/^(?:xl|l|m|s)$/]",
        "message": "<Composition> aboveSize must be one of 'xl' | 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Connector'] > JSXAttribute > JSXIdentifier[name!=/^(?:certainty|label|direction|length|style|key|ref|className|style|children)$/]",
        "message": "<Connector> doesn't accept that prop. Declared props: certainty, label, direction, length, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Connector'] > JSXAttribute[name.name='certainty'] > Literal[value!=/^(?:confirmed|provisional|unknown)$/]",
        "message": "<Connector> certainty must be one of 'confirmed' | 'provisional' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Connector'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|down)$/]",
        "message": "<Connector> direction must be one of 'right' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsequenceNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:who|children|style|key|ref|className|style|children)$/]",
        "message": "<ConsequenceNote> doesn't accept that prop. Declared props: who, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CounterpointRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|style|key|ref|className|style|children)$/]",
        "message": "<CounterpointRail> doesn't accept that prop. Declared props: children, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|reopens|style|key|ref|className|style|children)$/]",
        "message": "<DecisionLine> doesn't accept that prop. Declared props: children, kind, reopens, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLine'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:decision|recommendation|question|refusal)$/]",
        "message": "<DecisionLine> kind must be one of 'decision' | 'recommendation' | 'question' | 'refusal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|columns|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceStrip> doesn't accept that prop. Declared props: items, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandleTruth'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|truth|decision|handleLabel|truthLabel|showLabels|orientation|handleSize|style|key|ref|className|style|children)$/]",
        "message": "<HandleTruth> doesn't accept that prop. Declared props: handle, truth, decision, handleLabel, truthLabel, showLabels, orientation, handleSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandleTruth'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<HandleTruth> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandleTruth'] > JSXAttribute[name.name='handleSize'] > Literal[value!=/^(?:xl|l|m|s)$/]",
        "message": "<HandleTruth> handleSize must be one of 'xl' | 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandoffFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:certainty|gated|release|state|stateLabel|next|owner|artifact|version|date|style|key|ref|className|style|children)$/]",
        "message": "<HandoffFooter> doesn't accept that prop. Declared props: certainty, gated, release, state, stateLabel, next, owner, artifact, version, date, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandoffFooter'] > JSXAttribute[name.name='certainty'] > Literal[value!=/^(?:confirmed|provisional|unknown|superseded)$/]",
        "message": "<HandoffFooter> certainty must be one of 'confirmed' | 'provisional' | 'unknown' | 'superseded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandoffFooter'] > JSXAttribute[name.name='release'] > Literal[value!=/^(?:internal|review|approved|restricted)$/]",
        "message": "<HandoffFooter> release must be one of 'internal' | 'review' | 'approved' | 'restricted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Legend'] > JSXAttribute > JSXIdentifier[name!=/^(?:states|gated|connectors|extra|style|key|ref|className|style|children)$/]",
        "message": "<Legend> doesn't accept that prop. Declared props: states, gated, connectors, extra, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadLane'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|children|boundary|style|key|ref|className|style|children)$/]",
        "message": "<LoadLane> doesn't accept that prop. Declared props: label, meta, children, boundary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|certainty|gated|state|kind|owner|carries|style|key|ref|className|style|children)$/]",
        "message": "<LoadNode> doesn't accept that prop. Declared props: title, subtitle, certainty, gated, state, kind, owner, carries, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadNode'] > JSXAttribute[name.name='certainty'] > Literal[value!=/^(?:confirmed|provisional|unknown)$/]",
        "message": "<LoadNode> certainty must be one of 'confirmed' | 'provisional' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Matrix'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|caption|firstColWidth|style|key|ref|className|style|children)$/]",
        "message": "<Matrix> doesn't accept that prop. Declared props: columns, rows, caption, firstColWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressionLadder'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|orientation|style|key|ref|className|style|children)$/]",
        "message": "<ProgressionLadder> doesn't accept that prop. Declared props: steps, current, orientation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressionLadder'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ProgressionLadder> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Provenance'] > JSXAttribute > JSXIdentifier[name!=/^(?:sources|version|date|supersedes|changed|maxLines|style|key|ref|className|style|children)$/]",
        "message": "<Provenance> doesn't accept that prop. Declared props: sources, version, date, supersedes, changed, maxLines, style."
      },
