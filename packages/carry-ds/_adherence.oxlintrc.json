        "selector": "JSXOpeningElement[name.name='StateMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:certainty|gated|gate|owner|clears|review|release|state|label|size|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<StateMark> doesn't accept that prop. Declared props: certainty, gated, gate, owner, clears, review, release, state, label, size, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateMark'] > JSXAttribute[name.name='certainty'] > Literal[value!=/^(?:confirmed|provisional|unknown|superseded)$/]",
        "message": "<StateMark> certainty must be one of 'confirmed' | 'provisional' | 'unknown' | 'superseded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateMark'] > JSXAttribute[name.name='release'] > Literal[value!=/^(?:internal|review|approved|restricted)$/]",
        "message": "<StateMark> release must be one of 'internal' | 'review' | 'approved' | 'restricted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateMark'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:confirmed|provisional|unknown|gated|superseded)$/]",
        "message": "<StateMark> state must be one of 'confirmed' | 'provisional' | 'unknown' | 'gated' | 'superseded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Threshold'] > JSXAttribute > JSXIdentifier[name!=/^(?:hasTruth|fn|orientation|style|key|ref|className|style|children)$/]",
        "message": "<Threshold> doesn't accept that prop. Declared props: hasTruth, fn, orientation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Threshold'] > JSXAttribute[name.name='fn'] > Literal[value!=/^(?:decision|evidence|progression|transition|reflection|separation)$/]",
        "message": "<Threshold> fn must be one of 'decision' | 'evidence' | 'progression' | 'transition' | 'reflection' | 'separation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Threshold'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Threshold> orientation must be one of 'horizontal' | 'vertical'."
